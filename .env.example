# Optional public API overrides for running the React app outside Docker.
VITE_CATALOG_API=http://localhost:8080
VITE_ORDER_API=http://localhost:8081
VITE_INSIGHTS_API=http://localhost:8082

# Change this before deployment. It protects catalog administration and order history.
ADMIN_KEY=replace-with-a-long-random-secret

# Local Docker database password. Use a unique secret outside local development.
POSTGRES_PASSWORD=replace-with-a-long-random-password
