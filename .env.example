# ════════════════════════════════════════════════════════════
#  Shasthi Masala — Environment Variables
#  Copy this file to .env and fill in the values.
#  NEVER commit the .env file to git.
# ════════════════════════════════════════════════════════════

# ─── PostgreSQL ──────────────────────────────────────────────
POSTGRES_DB=shasthi
POSTGRES_USER=shasthi
POSTGRES_PASSWORD=replace-with-a-long-random-password

# ─── JWT (SHARED across all services) ────────────────────────
# Must be the same value in user-service, catalog-service, order-service
JWT_SECRET=replace-with-a-long-random-jwt-secret
JWT_EXPIRES_IN=7d

# ─── Admin Registration Key ───────────────────────────────────
# Send as header  x-admin-key: <value>  during /api/users/register
# to create an ADMIN-role account.
ADMIN_KEY=replace-with-a-long-random-admin-key

# ─── Redis ───────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ─── Kafka ───────────────────────────────────────────────────
KAFKA_BROKERS=kafka:9092
KAFKA_CLIENT_ID=user-service
KAFKA_GROUP_ID=order-service-group

# ─── Service Ports (internal Docker network) ─────────────────
# These are the ports each service listens on INSIDE Docker.
# The only public-facing port is 3000 (NGINX).
USER_SERVICE_PORT=4000
CATALOG_SERVICE_PORT=8080
ORDER_SERVICE_PORT=8081
